<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Filee.App.Views.Capture.MobileMirrorWindow"
        Title="Mobile Screen Mirror"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        Width="360"
        Height="720"
        MinWidth="320"
        MinHeight="620"
        CanResize="True"
        ShowInTaskbar="False">

  <Border Background="#1C1C1E" CornerRadius="36" BorderThickness="4" BorderBrush="#3A3A3C"
          BoxShadow="0 12 32 #55000000" Padding="10">

    <Grid RowDefinitions="Auto,*,Auto">
      <!-- Phone Bezel Header (Draggable) -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10,4,10,8"
            PointerPressed="OnHeaderPointerPressed" Background="Transparent" Cursor="SizeAll">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Width="7" Height="7" CornerRadius="3.5" Background="#30D158" />
          <TextBlock Text="Mobile Mirror" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
        </StackPanel>

        <!-- Speaker Notch / Island -->
        <Border Grid.Column="1" HorizontalAlignment="Center" Width="60" Height="6"
                Background="#2C2C2E" CornerRadius="3" />

        <!-- Close / Dock Buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Click="OnDockRightClick" Background="Transparent" Padding="0" Width="20" Height="20" ToolTip.Tip="Dock to Right">
            <TextBlock Text="⇥" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" />
          </Button>
          <Button Click="OnCloseClick" Background="Transparent" Padding="0" Width="20" Height="20" ToolTip.Tip="Close">
            <TextBlock Text="✕" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Screen Display Area -->
      <Border Grid.Row="1" Background="#000000" CornerRadius="24" ClipToBounds="True">
        <Panel>
          <!-- Live Stream Frame Image -->
          <Image Name="FrameImage" Stretch="Uniform" />

          <!-- Disconnect Floating Button (Visible only when streaming) -->
          <Button Name="DisconnectBtn" Click="OnDisconnectClick"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="12" CornerRadius="12" Height="24" Padding="8,0"
                  Background="#99000000" Foreground="White" BorderBrush="#44FFFFFF" BorderThickness="1"
                  IsVisible="False" Cursor="Hand" ToolTip.Tip="Disconnect stream">
            <TextBlock Text="Disconnect ⏹" FontSize="10" FontWeight="SemiBold" />
          </Button>

          <!-- Waiting & Connection Panel (1PhoneMirror Style) -->
          <ScrollViewer Name="WaitingPanel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="16,14">
              <!-- Platform Switcher Tabs -->
              <Border Background="#2C2C2E" CornerRadius="10" Padding="3">
                <Grid ColumnDefinitions="*,*">
                  <RadioButton Name="IosRadio" Grid.Column="0" Content="🍏 iPhone / iPad"
                               IsChecked="True" GroupName="PlatformGroup"
                               HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               IsCheckedChanged="OnPlatformChanged" />
                  <RadioButton Name="AndroidRadio" Grid.Column="1" Content="🤖 Android"
                               GroupName="PlatformGroup"
                               HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               IsCheckedChanged="OnPlatformChanged" />
                </Grid>
              </Border>

              <!-- 🍏 iPhone (AirPlay) Panel -->
              <StackPanel Name="IosPanel" Spacing="12">
                <!-- AirPlay Hero Badge -->
                <Border Background="#1C1C1E" CornerRadius="14" Padding="14" BorderBrush="#2C2C2E" BorderThickness="1">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="📺" FontSize="36" HorizontalAlignment="Center" />
                    <TextBlock Text="AirPlay Screen Mirroring" FontSize="13" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" />
                    <Border Background="#1A30D158" CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#30D158" VerticalAlignment="Center" />
                        <TextBlock Name="AirPlayStatusBadgeText" Text="Receiver Ready on Wi-Fi" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#30D158" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <TextBlock Name="AirPlayIpText" Text="" FontSize="10" Foreground="#8E8E93" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Steps Card -->
                <Border Background="#1C1C1E" CornerRadius="14" Padding="14" BorderBrush="#2C2C2E" BorderThickness="1">
                  <StackPanel Spacing="10">
                    <TextBlock Text="How to Connect:" FontWeight="Bold" FontSize="11" Foreground="#8E8E93" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="18" Height="18" CornerRadius="9" Background="#007AFF">
                        <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="Ensure iPhone is on the same Wi-Fi network."
                                 FontSize="11" Foreground="#E5E5EA" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="18" Height="18" CornerRadius="9" Background="#007AFF">
                        <TextBlock Text="2" FontSize="10" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="Swipe down to open Control Center."
                                 FontSize="11" Foreground="#E5E5EA" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="18" Height="18" CornerRadius="9" Background="#007AFF">
                        <TextBlock Text="3" FontSize="10" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="Tap Screen Mirroring (⧉) and choose:"
                                 FontSize="11" Foreground="#E5E5EA" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Device Name Highlight -->
                    <Border Background="#2C2C2E" CornerRadius="8" Padding="10,6" Margin="26,0,0,0">
                      <TextBlock Name="AirPlayDeviceNameText" Text="Filee (AirPlay)"
                                 FontFamily="Consolas,Menlo,Monospace" FontSize="12" FontWeight="Bold"
                                 Foreground="#0A84FF" />
                    </Border>

                    <Button Name="RestartAirPlayBtn" Click="OnRestartAirPlayClick"
                            Background="#2C2C2E" Foreground="#8E8E93" CornerRadius="8" Height="26" Padding="8,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" Cursor="Hand">
                      <TextBlock Text="🔄 Re-announce / Restart Receiver" FontSize="10" FontWeight="SemiBold" />
                    </Button>

                    <TextBlock Text="Your iPhone screen will instantly appear here."
                               FontSize="10" Foreground="#8E8E93" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- 🤖 Android Panel (USB & Wireless Debugging) -->
              <StackPanel Name="AndroidPanel" Spacing="12" IsVisible="False">
                <!-- Section 1: USB Mirroring -->
                <Border Background="#1C1C1E" CornerRadius="14" Padding="12" BorderBrush="#2C2C2E" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="USB Mirroring (Plug &amp; Play)" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Connect phone via USB with USB Debugging enabled." FontSize="10" Foreground="#8E8E93" TextWrapping="Wrap" />

                    <Button Name="ScanUsbBtn" Click="OnScanUsbClick"
                            Background="#2C2C2E" Foreground="White" CornerRadius="8" Height="28" Padding="10,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                      <TextBlock Text="🔍 Detect Connected USB Phone" FontSize="11" FontWeight="SemiBold" />
                    </Button>

                    <TextBlock Name="UsbDeviceStatusText" Text="No device selected yet"
                               FontSize="10.5" Foreground="#8E8E93" HorizontalAlignment="Center" />

                    <Button Name="StartUsbMirrorBtn" Click="OnStartUsbMirrorClick"
                            Background="#30D158" Foreground="Black" CornerRadius="8" Height="28" Padding="10,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" IsEnabled="False">
                      <TextBlock Text="▶ Start USB Screen Mirror" FontSize="11" FontWeight="Bold" />
                    </Button>
                  </StackPanel>
                </Border>

                <!-- Section 2: Wireless Debugging -->
                <Border Background="#1C1C1E" CornerRadius="14" Padding="12" BorderBrush="#2C2C2E" BorderThickness="1">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="📶" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="Wireless Debugging (Wi-Fi)" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Settings → Developer options → Wireless debugging → Pair with pairing code"
                               FontSize="9.5" Foreground="#8E8E93" TextWrapping="Wrap" />

                    <!-- Inputs -->
                    <TextBox Name="WirelessIpBox" PlaceholderText="IP:Port (e.g. 192.168.1.50:39182)"
                             FontSize="11" Height="28" CornerRadius="6" Background="#2C2C2E" Foreground="White" />
                    <TextBox Name="WirelessCodeBox" PlaceholderText="6-digit Pairing Code"
                             FontSize="11" Height="28" CornerRadius="6" Background="#2C2C2E" Foreground="White" />

                    <Button Name="PairWirelessBtn" Click="OnPairWirelessClick"
                            Background="#007AFF" Foreground="White" CornerRadius="8" Height="28" Padding="10,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                      <TextBlock Text="Pair &amp; Start Wireless Mirror" FontSize="11" FontWeight="Bold" />
                    </Button>

                    <TextBlock Name="WirelessStatusText" Text=""
                               FontSize="10" Foreground="#8E8E93" HorizontalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!-- Section 3: Cast / Smart View -->
                <Border Background="#1C1C1E" CornerRadius="14" Padding="12" BorderBrush="#2C2C2E" BorderThickness="1">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="📺" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="Smart View / Miracast" FontWeight="Bold" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Cast from Samsung Smart View, Xiaomi or Pixel." FontSize="9.5" Foreground="#8E8E93" TextWrapping="Wrap" />
                    <Button Click="OnOpenWindowsCastClick"
                            Background="Transparent" BorderBrush="#3A3A3C" BorderThickness="1"
                            Foreground="#0A84FF" CornerRadius="8" Height="26" Padding="10,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand">
                      <TextBlock Text="Open Windows Projection Settings ↗" FontSize="10.5" FontWeight="SemiBold" />
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>

      <!-- Footer Bar -->
      <Border Grid.Row="2" Height="14" HorizontalAlignment="Center" Width="80"
              Margin="0,6,0,2" Background="#3A3A3C" CornerRadius="2" />
    </Grid>
  </Border>
</Window>
