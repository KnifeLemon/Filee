<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels.Capture"
        x:Class="Filee.App.Views.Capture.CaptureStudioEditorWindow"
        x:DataType="vm:CaptureStudioEditorViewModel"
        Title="Capture Studio - Filee"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="960"
        Height="680"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <Border Background="{DynamicResource WindowBackgroundBrush}" Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Top Header -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://Filee/Assets/Icons/filee.png" Width="26" Height="26" VerticalAlignment="Center" />
          <TextBlock FontSize="17" FontWeight="Bold" VerticalAlignment="Center">
            <Run Text="Capture Studio" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Run Text="Editor" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
          </TextBlock>
        </StackPanel>

        <!-- Video Info Pill -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="12" Padding="12,5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Duration:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding VideoDurationText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Main Two-Column Content -->
      <Grid Grid.Row="1" ColumnDefinitions="*,16,380" Margin="0,0,0,14">

        <!-- Left Column: Video Preview, Timeline & Trim -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="12" Padding="14">
          <Grid RowDefinitions="*,Auto,Auto">

            <!-- Video Player Preview Container -->
            <Border Grid.Row="0" Background="#0A0A0C" CornerRadius="8" ClipToBounds="True">
              <Panel>
                <Image Source="{Binding CurrentFrameBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="🎬 Video Preview" Foreground="#33FFFFFF" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding CurrentFrameBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                <!-- Subtitle Overlay -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                        Background="#CC000000" CornerRadius="6" Padding="12,6"
                        IsVisible="{Binding ActiveSubtitleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding ActiveSubtitleText}" Foreground="White" FontSize="14"
                             FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                </Border>
              </Panel>
            </Border>

            <!-- Playback & Scrubber Controls -->
            <StackPanel Grid.Row="1" Margin="0,14,0,10" Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding CurrentPositionText}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="{Binding VideoDuration.TotalSeconds}"
                        Value="{Binding CurrentPosition}" />
                <TextBlock Grid.Column="2" Text="{Binding VideoDurationText}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding TogglePlayCommand}" Width="36" Height="32" Padding="0"
                          CornerRadius="6" Background="{DynamicResource AccentSubtleBrush}">
                    <TextBlock Text="{Binding IsPlaying, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, StringFormat='⏸', FallbackValue='▶'}"
                               FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                  </Button>
                </StackPanel>

                <!-- Split At Playhead Action -->
                <Button Grid.Column="2" Command="{Binding SplitAtPlayheadCommand}"
                        Padding="10,6" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource SubtleBorderBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="✂" FontSize="12" />
                    <TextBlock Text="Split at Playhead" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <!-- Trim Controls Card -->
            <Border Grid.Row="2" Background="{DynamicResource SubtleBorderBrush}" CornerRadius="8" Padding="12,10">
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="Trim Start (sec):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <NumericUpDown Minimum="0" Maximum="{Binding TrimEnd}" Value="{Binding TrimStart}" FormatString="0.0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Trim End (sec):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <NumericUpDown Minimum="{Binding TrimStart}" Maximum="{Binding VideoDuration.TotalSeconds}" Value="{Binding TrimEnd}" FormatString="0.0" />
                </StackPanel>
              </Grid>
            </Border>

          </Grid>
        </Border>

        <!-- Right Column: Subtitles, Translation & Export -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="12" Padding="14">
          <Grid RowDefinitions="Auto,*,Auto">

            <!-- Subtitles & Translation Header -->
            <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Captions &amp; Subtitles" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding AddSubtitleCommand}" Padding="8,4" CornerRadius="4"
                        FontSize="11" Background="Transparent" BorderBrush="{DynamicResource SubtleBorderBrush}">
                  <TextBlock Text="+ Add Cue" />
                </Button>
              </Grid>

              <!-- Auto-Generate Captions Button -->
              <Button Command="{Binding GenerateCaptionsCommand}" IsEnabled="{Binding !IsGeneratingCaptions}"
                      Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="✨" FontSize="13" />
                  <TextBlock Text="Auto Captions (Whisper AI)" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
              </Button>

              <!-- Translation Panel -->
              <Grid ColumnDefinitions="*,8,Auto">
                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="12" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Command="{Binding TranslateCaptionsCommand}" IsEnabled="{Binding !IsTranslatingCaptions}"
                        Padding="10,0" Height="32" Background="{DynamicResource AccentSubtleBrush}">
                  <TextBlock Text="Translate" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Button>
              </Grid>
            </StackPanel>

            <!-- Subtitle Cues List -->
            <Border Grid.Row="1" Background="{DynamicResource SubtleBorderBrush}" CornerRadius="8" Padding="6" Margin="0,0,0,10">
              <ListBox ItemsSource="{Binding Subtitles}" SelectedItem="{Binding SelectedSubtitle}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="3" Margin="2">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="{Binding TimeRangeFormatted}" FontSize="10"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                      </Grid>
                      <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TranslatedText, StringFormat='🌐 {0}'}" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                 IsVisible="{Binding TranslatedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <!-- Export Section -->
            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock Text="Export Video" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
              <Grid ColumnDefinitions="*,12,Auto">
                <ComboBox Grid.Column="0" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}"
                          HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Command="{Binding ExportVideoCommand}" IsEnabled="{Binding !IsExporting}"
                        Classes="accent" MinWidth="130" Height="36" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="💾" FontSize="12" />
                    <TextBlock Text="Export Video" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Button>
              </Grid>

              <!-- Real 0-100% Progress Bar -->
              <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsExporting}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Exporting Video..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding ExportProgress, StringFormat='{}{0:F0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}" Height="6" CornerRadius="3" />
              </StackPanel>
            </StackPanel>

          </Grid>
        </Border>

      </Grid>

      <!-- Bottom Status Bar -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="8" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding StatusMessage, FallbackValue='Ready'}" FontSize="11"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ExportProgress}"
                       Width="140" Height="6" CornerRadius="3" VerticalAlignment="Center"
                       IsVisible="{Binding IsExporting}" />
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
