<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels.Capture"
        x:Class="Filee.App.Views.Capture.CaptureStudioConfigWindow"
        x:DataType="vm:CaptureStudioConfigViewModel"
        Title="Capture Studio - Filee"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <Border Background="{DynamicResource WindowBackgroundBrush}" Padding="24">
    <StackPanel Spacing="18">

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://Filee/Assets/Icons/filee.png" Width="26" Height="26" VerticalAlignment="Center" />
          <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
            <Run Text="Capture" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Run Text="Studio" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
          </TextBlock>
        </StackPanel>
        <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="12" Padding="10,4">
          <TextBlock Text="Screen Recording" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
        </Border>
      </Grid>

      <!-- Recording Source Selection Card -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1.5"
              BorderBrush="{DynamicResource AccentBrush}" CornerRadius="12" Padding="16">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Recording Source" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="8" Padding="8,3"
                    IsVisible="{Binding IsAppTargetMode}">
              <TextBlock Text="⚡ Auto-Detected App" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Border>
          </Grid>

          <!-- Source Type Tabs -->
          <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,4">
            <RadioButton Grid.Column="0" Content="App Window" GroupName="SourceTypeGroup"
                         IsChecked="{Binding IsAppWindowSource}" />
            <RadioButton Grid.Column="1" Content="Full Screen" GroupName="SourceTypeGroup"
                         IsChecked="{Binding IsFullScreenSource}" />
            <RadioButton Grid.Column="2" Content="Custom Region" GroupName="SourceTypeGroup"
                         IsChecked="{Binding IsCustomRegionSource}" />
          </Grid>

          <!-- App Window Selector (Shows all open windows, with detected pre-selected) -->
          <StackPanel Spacing="6" IsVisible="{Binding IsAppWindowSource}">
            <TextBlock Text="Choose Application Window:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding OpenWindows}" SelectedItem="{Binding SelectedWindow}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="🗔 " FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Tip: You can select any running window above to record only that application."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <!-- Full Screen Selector -->
          <StackPanel Spacing="6" IsVisible="{Binding IsFullScreenSource}">
            <TextBlock Text="Select Display / Monitor:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Custom Region Info -->
          <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="6" Padding="10"
                  IsVisible="{Binding IsCustomRegionSource}">
            <TextBlock Text="Interactive crosshair will let you select any rectangular screen area upon starting."
                       FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Video & Audio Settings Card -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="10" Padding="16">
        <StackPanel Spacing="14">
          <TextBlock Text="Capture Quality &amp; Audio" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />

          <!-- Resolution & Framerate Grid -->
          <Grid ColumnDefinitions="*,16,*" Margin="0,2">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Resolution" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <!-- Frame Rate Header with Live Badge -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Frame Rate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="6" Padding="6,2">
                  <TextBlock Text="{Binding SelectedFramerate, StringFormat='{}{0} FPS'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
              </Grid>

              <!-- Discrete Frame Rate Slider (Snapped to 15, 24, 30, 60, 120 FPS) -->
              <Slider Minimum="0" Maximum="4" Value="{Binding SelectedFramerateIndex}"
                      IsSnapToTickEnabled="True" TickFrequency="1" Margin="8,2,8,0" />

              <!-- Instant Snap Dots (15, 24, 30, 60, 120) aligned with discrete steps -->
              <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto" Margin="8,-2,8,0">
                <Button Grid.Column="0" Command="{Binding SetFramerateCommand}" CommandParameter="15"
                        Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="15 FPS">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="15" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding SetFramerateCommand}" CommandParameter="24"
                        Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="24 FPS (Cinematic)">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="24" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="4" Command="{Binding SetFramerateCommand}" CommandParameter="30"
                        Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="30 FPS (Standard)">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="30" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="6" Command="{Binding SetFramerateCommand}" CommandParameter="60"
                        Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="60 FPS (Smooth)">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="60" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button Grid.Column="8" Command="{Binding SetFramerateCommand}" CommandParameter="120"
                        Background="Transparent" Padding="0" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="120 FPS (High Refresh)">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="120" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Audio Toggles -->
          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <ToggleSwitch Grid.Column="0" Content="Microphone" IsChecked="{Binding EnableMicrophone}" />
            <ToggleSwitch Grid.Column="1" Content="System Audio" IsChecked="{Binding EnableSystemAudio}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Effects & Controls Card -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="10" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Visual Effects &amp; Timing" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
          <Grid ColumnDefinitions="*,*">
            <ToggleSwitch Grid.Column="0" Content="Cursor Highlight" IsChecked="{Binding HighlightCursor}" />
            <ToggleSwitch Grid.Column="1" Content="Spotlight Mode" IsChecked="{Binding SpotlightMode}" />
          </Grid>
          <ToggleSwitch Content="3-Second Countdown before starting" IsChecked="{Binding CountdownBeforeRecording}" />
        </StackPanel>
      </Border>

      <!-- Action Buttons -->
      <Grid ColumnDefinitions="*,12,Auto">
        <Button Grid.Column="0" Command="{Binding CancelCommand}"
                Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Height="40" Background="Transparent" BorderBrush="{DynamicResource SubtleBorderBrush}" />

        <Button Grid.Column="2" Command="{Binding StartRecordingCommand}"
                Classes="accent" MinWidth="180" Height="40"
                HorizontalContentAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="Red" VerticalAlignment="Center" />
            <TextBlock Text="Start Recording" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

    </StackPanel>
  </Border>
</Window>
