<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Filee.App.Views.ExtensionChangeProgressWindow"
        Title="Filee"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        PointerPressed="OnPointerPressed">
  <Border Classes="card" Margin="16" Padding="20,18" BoxShadow="{DynamicResource CardShadow}"
          Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource SoftRadius}">
    <DockPanel>
      <Image DockPanel.Dock="Left" Source="avares://Filee/Assets/Icons/filee.png" Width="42" Height="42"
             VerticalAlignment="Center" Margin="0,0,16,0" />
      <StackPanel Spacing="10" VerticalAlignment="Center">
        <StackPanel Spacing="3">
          <TextBlock Classes="h2" FontWeight="SemiBold" Text="{DynamicResource extension_progress.title}" />
          <TextBlock x:Name="MessageText" Classes="caption" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" Classes="soft accent" Height="6" Margin="0,4,0,0" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
