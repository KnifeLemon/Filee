<!-- Main window = settings: navigation on the left, current page on the right. Closing hides to the tray. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Filee"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="1080" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="Auto,*">
    <!-- Navigation: full width with titles, or collapsed to an icon rail (tooltips instead of text). The width animates. -->
    <Border Classes="navpane" Classes.collapsed="{Binding IsNavCollapsed}" Width="{Binding NavWidth}" ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="{Binding NavPadding}">
        <StackPanel DockPanel.Dock="Top" Classes="navheader" Orientation="Horizontal" Spacing="10">
          <Image Source="avares://Filee/Assets/Icons/filee.png" Width="30" Height="30" />
          <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}">
            <TextBlock Text="Filee" FontSize="18" FontWeight="Bold" />
            <TextBlock Classes="caption" Text="{DynamicResource app.tagline}" />
          </StackPanel>
        </StackPanel>
        <!-- Bottom: the running version, and a download button when a newer release is out. -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,12,4,0">
          <!-- Collapsed: the same actions as icons only, each with a tooltip -->
          <StackPanel Spacing="8" IsVisible="{Binding IsNavCollapsed}">
            <Button Classes.accent="{Binding !Updates.IsOptional}" Padding="8,6" HorizontalAlignment="Stretch"
                    Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="{Binding UpdateTip}" ToolTip.Placement="Right">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
            </Button>
            <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnOpenGitHub"
                    ToolTip.Tip="{Binding RepositoryUrl}" ToolTip.Placement="Right">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" />
            </Button>
            <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnSponsor"
                    ToolTip.Tip="{DynamicResource about.sponsor}" ToolTip.Placement="Right">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
            </Button>
          </StackPanel>
          <!-- Expanded -->
          <StackPanel Spacing="8" IsVisible="{Binding !IsNavCollapsed}">
            <!-- Accent for required and recommended updates, plain for optional ones; a pill says which -->
            <Button x:Name="UpdateButton" Classes.accent="{Binding !Updates.IsOptional}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="{Binding UpdateTip}">
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource DangerBrush}" IsVisible="{Binding Updates.IsRequired}">
                  <TextBlock Text="{DynamicResource update.pill.Required}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding Updates.IsOptional}">
                  <TextBlock Classes="caption" Text="{DynamicResource update.pill.Optional}" FontSize="11" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
                  <TextBlock Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Button>
            <!-- The project on GitHub, and sponsoring it -->
            <Grid ColumnDefinitions="*,6,*">
              <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnOpenGitHub" ToolTip.Tip="{Binding RepositoryUrl}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" />
                  <TextBlock Text="GitHub" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="navlink" HorizontalAlignment="Stretch" Click="OnSponsor">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
                  <TextBlock Text="{DynamicResource about.sponsor}" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock x:Name="VersionLabel" Classes="caption" Margin="8,0,0,0" Text="{Binding VersionText}" />
          </StackPanel>
        </StackPanel>
        <!-- Collapse / expand: sits just above the update / GitHub / Sponsor group; the logo and name stay at the top -->
        <Button DockPanel.Dock="Bottom" Classes="icon navtoggle" Margin="0,8,0,0" Command="{Binding ToggleNavCommand}"
                ToolTip.Tip="{Binding NavToggleTip}" ToolTip.Placement="Right" AutomationProperties.Name="{Binding NavToggleTip}">
          <PathIcon Width="17" Height="17" Data="{StaticResource Icon.Sidebar}" />
        </Button>
        <ListBox Classes="nav" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <!-- Fills the whole row, so the tooltip (collapsed only) shows anywhere on it -->
              <Border Background="Transparent" Padding="12,9" ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Right"
                      AutomationProperties.Name="{Binding Title}">
                <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                  <PathIcon Classes="navicon" Width="17" Height="17" Data="{Binding Icon}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" IsVisible="{Binding ShowTitle}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page -->
    <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
      <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="32,26,32,32" MaxWidth="980" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
