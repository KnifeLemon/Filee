<!-- The slice-label fields of the preset and group editors: the slice's icon (a flyout with the icon picker), a short
     name for the donut, what the slice shows, and which way its name runs. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels"
             xmlns:v="using:Filee.App.Views"
             x:Class="Filee.App.Views.SliceLabelFieldsView"
             x:DataType="vm:SliceLabelFields">
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="Auto,12,*">
      <StackPanel>
        <TextBlock Classes="label" Text="{DynamicResource presets.icon}" />
        <Button x:Name="IconButton" MinWidth="120" HorizontalContentAlignment="Left"
                AutomationProperties.Name="{DynamicResource presets.icon}" ToolTip.Tip="{Binding IconText}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="18" Height="18" Data="{Binding IconData}"
                      IsVisible="{Binding IconData, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding IconText}" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <v:IconPickerFlyout DataContext="{Binding IconPicker}" />
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="label" Text="{DynamicResource presets.short_name}" />
        <TextBox x:Name="ShortNameBox" Text="{Binding ShortName}" Watermark="{Binding ShortNamePlaceholder}"
                 AutomationProperties.Name="{DynamicResource presets.short_name}"
                 ToolTip.Tip="{DynamicResource presets.short_name_hint}" />
      </StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,12,*">
      <StackPanel>
        <TextBlock Classes="label" Text="{DynamicResource presets.show}" />
        <ComboBox x:Name="ShowChoice" ItemsSource="{Binding ShowChoices}" SelectedItem="{Binding Show}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="{DynamicResource presets.show}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Classes="label" Text="{DynamicResource presets.direction}" />
        <ComboBox x:Name="DirectionChoice" ItemsSource="{Binding DirectionChoices}" SelectedItem="{Binding Direction}"
                  HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource presets.direction}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
