<!-- "Upscale Quality": upscale images using local AI models (Real-ESRGAN / NCNN). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        xmlns:upscale="using:Filee.Engines.Upscale"
        x:Class="Filee.App.Views.UpscaleWindow"
        x:DataType="vm:UpscaleViewModel"
        Title="{DynamicResource preset.upscale}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="540" SizeToContent="Height" MinWidth="460" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Footer Buttons -->
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{DynamicResource common.close}" Click="OnCancel" IsCancel="True" />
          <Button Classes="accent" Content="{DynamicResource upscale.button_start}"
                  Command="{Binding StartUpscaleCommand}"
                  IsEnabled="{Binding !IsProcessing}"
                  IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main Content -->
    <StackPanel Margin="20,18,20,16" Spacing="14">
      <!-- Title & Caption -->
      <StackPanel Spacing="4">
        <TextBlock Classes="h2" Text="{Binding Heading}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HeadingTip}" />
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource engines.upscaler.modal_description}" />
      </StackPanel>

      <!-- Step A: Select Model -->
      <StackPanel Spacing="4">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Classes="label" Text="{DynamicResource upscale.model}" />
          <TextBlock DockPanel.Dock="Right" Classes="caption" Text="{Binding ModelStatusText}" />
        </DockPanel>
        <Grid ColumnDefinitions="*,Auto">
          <ComboBox Grid.Column="0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                    HorizontalAlignment="Stretch" IsEnabled="{Binding !IsProcessing}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="upscale:UpscaleModel">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Classes="caption" Text="{Binding License, StringFormat='({0})'}" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Classes="icon" Margin="6,0,0,0" VerticalAlignment="Center"
                  IsVisible="{Binding IsSelectedModelInstalled}"
                  IsEnabled="{Binding !IsProcessing}"
                  Click="OnDeleteModel"
                  ToolTip.Tip="{DynamicResource common.delete}"
                  AutomationProperties.Name="{DynamicResource common.delete}">
            <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Trash}" />
          </Button>
        </Grid>
        <TextBlock Classes="caption" Text="{Binding SelectedModel.Description}" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>

      <!-- Step B: Scale Factor Slider -->
      <StackPanel Spacing="4">
        <DockPanel LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" Classes="label" Text="{DynamicResource upscale.scale}" />
          <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Scale, StringFormat='{}{0}×'}" />
        </DockPanel>
        <Slider Minimum="1" Maximum="4" Value="{Binding Scale}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                IsEnabled="{Binding !IsProcessing}" />
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="caption" Text="1×" />
          <TextBlock Grid.Column="2" Classes="caption" Text="2×" />
          <TextBlock Grid.Column="4" Classes="caption" Text="3×" />
          <TextBlock Grid.Column="6" Classes="caption" Text="4×" />
        </Grid>
      </StackPanel>

      <!-- Step C: Output Format -->
      <StackPanel Spacing="4">
        <TextBlock Classes="label" Text="{DynamicResource upscale.output_format}" />
        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}"
                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsProcessing}" />
      </StackPanel>

      <!-- Step D: Resolution Preview -->
      <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="12,10">
        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="{DynamicResource upscale.resolution_label}" />
          <TextBlock FontWeight="SemiBold" Text="{Binding ResolutionPreview}" FlowDirection="LeftToRight" />
        </StackPanel>
      </Border>

      <!-- Progress Section -->
      <StackPanel Spacing="6" IsVisible="{Binding IsProcessing}">
        <ProgressBar Maximum="100" Value="{Binding ProgressValue}" />
        <TextBlock Classes="caption" Text="{Binding ProgressText}" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Success Notice -->
      <Border Background="#2216A34A" BorderBrush="#16A34A" BorderThickness="1" CornerRadius="6" Padding="12,8"
              IsVisible="{Binding IsCompleted}">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Classes="subtle" Content="{DynamicResource home.open_folder}"
                  Command="{Binding OpenOutputFolderCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="✓" Foreground="#16A34A" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource upscale.success}" Foreground="#16A34A" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Error Notice -->
      <Border Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="12,8"
              IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#EF4444" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </DockPanel>
</Window>