<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             x:Class="Filee.App.Views.Pages.FieldsPage"
             x:DataType="vm:FieldsPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource fields.title}" />
    <TextBlock Text="{DynamicResource fields.description}" TextWrapping="Wrap" />
    <Border Classes="card">
      <StackPanel Spacing="14">
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FieldSwitchViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock Classes="label" Text="{Binding Name}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding Formats}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}"
                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="caption" Text="{Binding AlwaysShown}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
