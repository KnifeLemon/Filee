<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:svc="using:Filee.App.Services"
             xmlns:c="using:Filee.App.Controls"
             x:Class="Filee.App.Views.Pages.EnginesPage"
             x:DataType="vm:EnginesPageViewModel">
  <UserControl.Styles>
    <!-- The card being dragged stays in the list as an empty outlined slot; a smaller copy of it follows the pointer
         (EnginesPage.axaml.cs). -->
    <Style Selector="Border.card.engine.dragging">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.card.engine.dragging > StackPanel">
      <Setter Property="Opacity" Value="0" />
    </Style>
  </UserControl.Styles>
  <!-- Keep editor columns usable on narrow windows; the page still scrolls vertically in MainWindow. -->
  <ScrollViewer x:Name="EditorScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" MinWidth="660" Width="{Binding #EditorScroller.Viewport.Width}" HorizontalAlignment="Left">
      <DockPanel>
        <Button DockPanel.Dock="Right" Command="{Binding RecheckCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- Turns while the recheck runs (Spin.IsActive follows RecheckCommand.IsRunning; the code is in Controls/Spin.cs). -->
            <PathIcon c:Spin.IsActive="{Binding RecheckCommand.IsRunning}"
                      Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
            <TextBlock Text="{DynamicResource engines.recheck}" />
          </StackPanel>
        </Button>
        <StackPanel>
          <TextBlock Classes="h1" Text="{DynamicResource engines.title}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource engines.description}" />
        </StackPanel>
      </DockPanel>

      <!-- Optional engines: downloaded on demand because they are large. -->
      <StackPanel Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="h2" Text="{DynamicResource engines.optional_title}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource engines.optional_description}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Packages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="svc:EnginePackageState">
              <Border Classes="card" Padding="16,12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button IsVisible="{Binding HasSettings}" Click="OnPackageSettings" ToolTip.Tip="{DynamicResource engines.lo_title}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Settings}" />
                        <TextBlock Text="{DynamicResource engines.settings}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="accent" Content="{DynamicResource engines.install}" IsVisible="{Binding CanInstall}"
                            Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}" />
                    <Button Classes="accent" Content="{DynamicResource engines.update}" IsVisible="{Binding CanUpdate}"
                            Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).InstallCommand}" CommandParameter="{Binding}" />
                    <Button Content="{DynamicResource engines.cancel}" IsVisible="{Binding IsBusy}"
                            Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).CancelCommand}" CommandParameter="{Binding}" />
                    <Button Content="{DynamicResource engines.use_own}" IsVisible="{Binding CanUseOwnCopy}" Click="OnUseOwnCopy"
                            ToolTip.Tip="{DynamicResource engines.use_own_hint}" />
                    <Button Content="{DynamicResource engines.stop_own}" IsVisible="{Binding UsesOwnCopy}" Click="OnStopOwnCopy" />
                    <!-- Without internet (#447): the same downloads, brought from another computer and checked as a download is. -->
                    <Button Content="{DynamicResource engines.offline}" IsVisible="{Binding HasOfflineMenu}"
                            ToolTip.Tip="{DynamicResource engines.offline_hint}">
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                          <MenuItem Header="{DynamicResource engines.install_from_files}" IsEnabled="{Binding CanInstallFromFiles}" Click="OnInstallFromFiles" />
                          <MenuItem Header="{DynamicResource engines.save_files}" Click="OnSaveFiles" />
                          <MenuItem Header="{DynamicResource engines.copy_links}" Click="OnCopyLinks" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="danger" Content="{DynamicResource engines.remove}" IsVisible="{Binding CanRemove}" Click="OnRemove" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <Border Classes="status" Classes.ok="{Binding StatusIsOk}" Classes.danger="{Binding StatusIsDanger}"
                              Classes.warn="{Binding StatusIsWarn}" Classes.accent="{Binding StatusIsAccent}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}" />
                    <TextBlock Classes="caption" Text="{Binding Sizes}" IsVisible="{Binding !UsesOwnCopy}" />
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding InstallGuidance}"
                               IsVisible="{Binding InstallGuidance, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="caption" Text="{Binding OwnCopyFolder}" IsVisible="{Binding ShowsCopyFolder}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding UpdateNote}"
                               IsVisible="{Binding UpdateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ProgressBar Classes="soft" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" Margin="0,4,0,0" />
                    <TextBlock Classes="caption" Text="{Binding ProgressDetail}" IsVisible="{Binding ProgressDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Spacing="2" Margin="0,8,0,0">
          <TextBlock Classes="h2" Text="{DynamicResource engines.all_title}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource engines.all_description}" />
        </StackPanel>
      </StackPanel>

      <!-- Every engine in priority order: drag a card (or use the arrows) to change it -->
      <Panel>
        <ItemsControl x:Name="EngineList" ItemsSource="{Binding Engines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EngineItemViewModel">
              <Border Classes="card engine" Classes.dragging="{Binding IsDragging}" Padding="16,12"
                      PointerPressed="OnEnginePressed">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                      <Button Classes="accent" IsVisible="{Binding IsTranslator}" Click="OnManageOllama" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Settings}" />
                          <TextBlock Text="{DynamicResource engines.ollama.manage}" />
                        </StackPanel>
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="{DynamicResource engines.move_up}" AutomationProperties.Name="{DynamicResource engines.move_up}"
                              Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource Icon.ArrowUp}" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="{DynamicResource engines.move_down}" AutomationProperties.Name="{DynamicResource engines.move_down}"
                              Command="{Binding $parent[ItemsControl].((vm:EnginesPageViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource Icon.ArrowDown}" />
                      </Button>
                    </StackPanel>
                    <!-- The grab handle: only here (not on the rest of the card or its arrows) the pointer is the move cursor. The
                         transparent background makes the whole strip around the dots count, not just the dots. -->
                    <Border DockPanel.Dock="Left" Background="Transparent" Cursor="SizeAll" Margin="-4,0,0,0" Padding="4,0,8,0">
                      <PathIcon Width="16" Height="16" Opacity="0.4" VerticalAlignment="Center" Data="{StaticResource Icon.DragVertical}" />
                    </Border>
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="999" Margin="2,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsAvailable}" />
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="999" Margin="2,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding StatusIsNeutral}" />
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="999" Margin="2,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource DangerBrush}" IsVisible="{Binding StatusIsDanger}" />
                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="999" Margin="2,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource WarningBrush}" IsVisible="{Binding StatusIsWarn}" />
                    <StackPanel Spacing="3" ToolTip.Tip="{Binding Detail}">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Border Classes="status" Classes.ok="{Binding StatusIsOk}" Classes.danger="{Binding StatusIsDanger}"
                                Classes.warn="{Binding StatusIsWarn}" Margin="0,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <TextBlock Classes="caption" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding Version}"
                                   IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding Conversions}" />
                      </WrapPanel>
                      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Description}"
                                 IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Holds the copy that follows the pointer while dragging. Not hit-testable. -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False" FlowDirection="LeftToRight" />
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
