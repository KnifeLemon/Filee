<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             x:Class="Filee.App.Views.Pages.WatchFoldersPage"
             x:DataType="vm:WatchFoldersPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource watch.title}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource watch.description}" />

    <Button Classes="accent" Command="{Binding AddCommand}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Plus}" />
        <TextBlock Text="{DynamicResource watch.add}" />
      </StackPanel>
    </Button>

    <TextBlock Classes="muted" Text="{DynamicResource watch.empty}" IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Rules}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="14" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WatchRuleViewModel">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" ToolTip.Tip="{DynamicResource watch.remove}">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Delete}" />
                </Button>
                <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{DynamicResource watch.enabled}" OffContent="{DynamicResource watch.enabled}" />
                <TextBlock Classes="muted" VerticalAlignment="Center" Margin="12,0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource watch.folder}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseFolder" />
                  <TextBox Text="{Binding Folder}" PlaceholderText="{DynamicResource watch.folder_placeholder}" />
                </DockPanel>
              </StackPanel>

              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.preset}" />
                  <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.originals}" />
                  <ComboBox ItemsSource="{Binding OriginalsChoices}" SelectedItem="{Binding Originals}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{DynamicResource watch.originals_hint}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource watch.output}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseOutput" />
                  <TextBox Text="{Binding OutputFolder}" PlaceholderText="{DynamicResource watch.output_placeholder}" />
                </DockPanel>
              </StackPanel>

              <CheckBox Content="{DynamicResource watch.subfolders}" IsChecked="{Binding IncludeSubfolders}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource watch.cli_hint}" />
  </StackPanel>
</UserControl>
