<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             x:Class="Filee.App.Views.Pages.WatchFoldersPage"
             x:DataType="vm:WatchFoldersPageViewModel">
  <UserControl.Styles>
    <Style Selector="Border.recipe:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    </Style>
    <Style Selector="PathIcon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="PathIcon.chevron.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource watch.title}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource watch.description}" />

    <Button Classes="accent" Command="{Binding AddCommand}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Plus}" />
        <TextBlock Text="{DynamicResource watch.add}" />
      </StackPanel>
    </Button>

    <TextBlock Classes="muted" Text="{DynamicResource watch.empty}" IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Rules}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="14" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:WatchRuleViewModel">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" ToolTip.Tip="{DynamicResource watch.remove}">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Delete}" />
                </Button>
                <ToggleSwitch IsChecked="{Binding Enabled}" OnContent="{DynamicResource watch.enabled}" OffContent="{DynamicResource watch.enabled}" />
                <TextBlock Classes="muted" VerticalAlignment="Center" Margin="12,0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
              </DockPanel>

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource watch.folder}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseFolder" />
                  <TextBox Text="{Binding Folder}" PlaceholderText="{DynamicResource watch.folder_placeholder}" />
                </DockPanel>
              </StackPanel>

              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.preset}" />
                  <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.originals}" />
                  <ComboBox ItemsSource="{Binding OriginalsChoices}" SelectedItem="{Binding Originals}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{DynamicResource watch.originals_hint}" />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Classes="label" Text="{DynamicResource watch.output}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource presets.browse}" Click="OnBrowseOutput" />
                  <TextBox Text="{Binding OutputFolder}" PlaceholderText="{DynamicResource watch.output_placeholder}" />
                </DockPanel>
              </StackPanel>

              <CheckBox Content="{DynamicResource watch.subfolders}" IsChecked="{Binding IncludeSubfolders}" />

              <!-- Optional: which files, and how converted files are named. Empty fields change nothing. -->
              <Button Classes="ghost" Command="{Binding ToggleOptionsCommand}" Padding="6,4" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Classes="chevron" Classes.open="{Binding ShowOptions}" Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" />
                  <TextBlock Text="{DynamicResource watch.options}" />
                </StackPanel>
              </Button>
              <StackPanel Spacing="12" IsVisible="{Binding ShowOptions}" Margin="8,0,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.include}" />
                  <!-- Only ";" separates: patterns and regular expressions may contain spaces and commas -->
                  <c:TagEditor Tags="{Binding IncludeTags}" Suggestions="{Binding IncludeSuggestions}" Text="{Binding IncludeText}"
                               AddCommand="{Binding AddIncludeCommand}" RemoveCommand="{Binding RemoveIncludeCommand}"
                               Separators=";" PlaceholderText="{DynamicResource watch.include_placeholder}" />
                  <TextBlock Classes="caption danger" Text="{Binding IncludeError}" TextWrapping="Wrap" IsVisible="{Binding IncludeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="caption" Text="{Binding IncludeMatches}" TextWrapping="Wrap" IsVisible="{Binding IncludeMatches, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Classes="caption" Text="{DynamicResource watch.include_hint}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.name}" />
                  <TextBox Text="{Binding FileNamePattern}" PlaceholderText="{Binding FileNamePlaceholder}" />
                  <TextBlock Classes="caption" Text="{DynamicResource watch.name_hint}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.rename}" />
                  <!-- The steps, applied in order -->
                  <ItemsControl ItemsSource="{Binding RenameSteps}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RenameStepViewModel">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="*,Auto,*,Auto">
                            <TextBox Text="{Binding Find}" PlaceholderText="{DynamicResource watch.rename_find}" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="→" Margin="8,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding Replace}" PlaceholderText="{DynamicResource watch.rename_replace}" />
                            <Button Grid.Column="3" Classes="icon" Margin="6,0,0,0" Command="{Binding RemoveCommand}" ToolTip.Tip="{DynamicResource watch.remove_step}">
                              <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" />
                            </Button>
                          </Grid>
                          <TextBlock Classes="caption danger" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding AddStepCommand}" Padding="10,5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Plus}" />
                        <TextBlock Text="{DynamicResource watch.add_step}" />
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Command="{Binding ToggleRecipesCommand}" Padding="6,4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Classes="chevron" Classes.open="{Binding ShowRecipes}" Width="12" Height="12" Data="{StaticResource Icon.ChevronRight}" />
                        <TextBlock Text="{DynamicResource watch.recipes}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- Ready-made replacements: what each does to an example; double-click or + adds it as a step -->
                  <StackPanel Spacing="4" IsVisible="{Binding ShowRecipes}">
                    <TextBlock Classes="caption" Text="{DynamicResource watch.recipes_hint}" TextWrapping="Wrap" />
                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                      <ItemsControl ItemsSource="{Binding Recipes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RenameRecipeViewModel">
                            <Border Classes="recipe" Padding="10,6" Background="Transparent" DoubleTapped="OnRecipeDoubleTapped">
                              <Grid ColumnDefinitions="*,*,Auto">
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                  <TextBlock Classes="caption" FontFamily="Consolas, Menlo, monospace" Text="{Binding Expression}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Example}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
                                <Button Grid.Column="2" Classes="icon" Command="{Binding AddCommand}" ToolTip.Tip="{DynamicResource watch.recipe_add}" VerticalAlignment="Center">
                                  <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Plus}" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- A converted file as it would be saved -->
              <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasPreview}">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="{DynamicResource watch.preview}" />
                  <SelectableTextBlock FontWeight="SemiBold" Text="{Binding PreviewExample}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption" Text="{Binding PreviewDetails}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource watch.cli_hint}" />
  </StackPanel>
</UserControl>
