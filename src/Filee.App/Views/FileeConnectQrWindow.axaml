<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.FileeConnectQrWindow"
        x:DataType="vm:FileeConnectViewModel"
        Title="{DynamicResource connect.title}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <Border Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel Margin="24,20,24,24" Spacing="16">
      <!-- Header bar with Title -->
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Image Source="avares://Filee/Assets/Icons/filee.png" Width="24" Height="24" />
        <TextBlock FontSize="17" FontWeight="Bold" VerticalAlignment="Center">
          <Run Text="Filee" Foreground="{DynamicResource TextPrimaryBrush}" />
          <Run Text="Connect" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
        </TextBlock>
      </StackPanel>

      <!-- Centered QR Code Card -->
      <Border Background="White" CornerRadius="12" Padding="12"
              BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
              HorizontalAlignment="Center">
        <Image Source="{Binding QrBitmap}" Width="210" Height="210" />
      </Border>

      <!-- 6-digit PIN Display Card -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="10" Padding="14,10"
              HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource connect.pin_label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PinCodeText}" FontSize="22" FontWeight="Bold" LetterSpacing="2"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Border Width="1" Height="20" Background="{DynamicResource SubtleBorderBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding PinRefreshHintText}" Classes="caption" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Direct Manual Address (Clean IP) -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
              BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="8" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource connect.manual_url_label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ManualUrl}" FontFamily="Consolas,Menlo,Monospace" FontSize="13.5"
                     Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Instructions Section -->
      <Border Classes="card" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
              CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <!-- Highlighted requirement badge -->
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="10,6">
            <TextBlock Text="{DynamicResource connect.qr_instruction_network}"
                       Foreground="White" FontWeight="Bold" FontSize="12.5"
                       TextAlignment="Center" TextWrapping="Wrap" />
          </Border>

          <!-- Instruction 1 -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" />
            <TextBlock Grid.Column="1" Text="{DynamicResource connect.qr_instruction_scan}"
                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
          </Grid>

          <!-- Instruction 2 -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" />
            <TextBlock Grid.Column="1" Text="{DynamicResource connect.manual_instruction_pin}"
                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
          </Grid>

          <!-- Instruction 3 -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="•" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" />
            <TextBlock Grid.Column="1" Text="{DynamicResource connect.qr_instruction_http}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </Grid>

          <!-- Windows Firewall Hint -->
          <TextBlock Text="{Binding FirewallHintText}" Classes="caption" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- Status Footer -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,2,0,0">
        <Ellipse Width="8" Height="8" Fill="{Binding StatusColorBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{DynamicResource connect.waiting_device}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
