<!-- The icon picker in the preset and group editors' Icon flyout: search, Default and None, then the icons by group.
     Arrow keys move between the icons, Enter or Space picks one, Esc closes. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels"
             x:Class="Filee.App.Views.IconPickerFlyout"
             x:DataType="vm:IconPickerViewModel"
             Width="344">
  <UserControl.Styles>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Classes="search clearButton" Margin="0,0,0,8" Text="{Binding Search}"
             Watermark="{DynamicResource presets.icon_search}" AutomationProperties.Name="{DynamicResource presets.icon_search}">
      <TextBox.InnerLeftContent>
        <PathIcon Width="14" Height="14" Margin="10,0,0,0" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource TextSecondaryBrush}" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
      <Button x:Name="DefaultButton" Classes.current="{Binding IsDefault}" Content="{DynamicResource presets.icon_default}"
              Command="{Binding PickDefaultCommand}" />
      <Button x:Name="NoneButton" Classes.current="{Binding IsNone}" Content="{DynamicResource presets.icon_none}"
              Command="{Binding PickNoneCommand}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
               Text="{DynamicResource presets.icon_no_match}" />
    <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IconSection">
            <StackPanel Margin="0,0,0,6">
              <TextBlock Classes="label" Text="{Binding Name}" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Icons}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:IconChoice">
                    <Button Classes="icon" Classes.current="{Binding IsCurrent}"
                            Command="{Binding $parent[UserControl].((vm:IconPickerViewModel)DataContext).PickCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                      <PathIcon Width="20" Height="20" Data="{Binding Data}" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
